\smjauxentry{art:putt-putt}{title}{Lagrangian Putt-Putt: A Holistic Investigation into Holonomically Constrained Forced-Geodesic Motion on Arbitrary $C^2$-Surfaces}
\smjauxentry{art:putt-putt}{author}{Noah Horne}
\smjauxentry{art:putt-putt}{year}{PhDS'26}
\smjauxentry{art:putt-putt}{affil}{UgS III}
\smjauxentry{art:putt-putt}{category}{article}
\smjauxentry{art:putt-putt}{cover-title}{Lagrangian Putt-Putt: Geodesic Motion on $C^2$-Surfaces}
\smjauxentry{art:putt-putt}{toc-title}{Lagrangian Putt-Putt: A Holistic Investigation into Holonomically Constrained Forced-Geodesic Motion on Arbitrary $C^2$-Surfaces}
\smjauxentry{art:putt-putt}{no-header}{}
\smjauxentry{art:putt-putt}{abstract}{This paper concerns the holistic investigation of golf ball dynamics. Specifically, in this paper we seek to determine the generalized equations of motion for a golf ball constained to a golf course of the form $z=h(x,y)$ under constant gravity $g$. In doing so, concepts such as Lagrangian mechanics, the principle of least action, variational calculus, and differential geometry are brought up. The paper is written in such a way that a reader with basic calculus knowledge should be able to meaningfully extract the important information of this paper. }
\newlabel{art:putt-putt}{{4.1}{41}{}{section*.17}{}}
\newlabel{art:putt-putt@cref}{{}{[1][41][]41}{}{}{}}
