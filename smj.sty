% ============================================================
%  smj/smj.sty — Master Package Loader
% ============================================================
%
%  This is the entry point for the SMJ journal style. It loads
%  every submodule in dependency order and wires up the pieces
%  that must come last (hyperref, cleveref, hypersetup).
%
%  Articles and editors should NOT edit this file. To change
%  the look of the journal, edit the relevant submodule under
%  smj/ instead (colors, fonts, layout, etc.).
%
%  ── STRUCTURE ──────────────────────────────────────────────
%
%      The loader runs in this order:
%
%        1. smjfonts     — encoding and font families
%        2. smjcolors    — color palette and acronym macros
%        3. Math/graphics infrastructure (amsmath, tikz, …)
%        4. smjtypo      — global spacing and stretch
%        5. smjlayout    — page geometry (A4, margins)
%        6. smjcore      — counters and article metadata
%        7. smjheaders   — running headers and footers
%        8. smjsections  — section heading styles
%        9. smjtheorems  — theorem-like environments
%       10. smjartwork   — article header and cover rendering
%       11. smjbib       — per-article bibliographies
%       12. hyperref + cleveref + hypersetup
%
%  ── USAGE ──────────────────────────────────────────────────
%
%      In main.tex:
%
%          \usepackage{smj}
%
%      That is the only line a document needs. Everything else
%      (fonts, colors, theorem environments, bibliography,
%      cover machinery) loads transitively.
%
%  ── CUSTOMIZATION ──────────────────────────────────────────
%
%      1. To disable an entire feature, comment out its
%         \RequirePackage line below. E.g. removing smjtheorems
%         drops every smj* theorem environment from the build.
%
%      2. The cover volume line is set from main.tex, not here:
%             \smjvolume{Inaugural Edition · Volume I · 2026}
%         Place that call right after \begin{document}, before
%         any \input{front/...}.
%
%      3. Do NOT reorder the submodules. Later modules depend
%         on earlier ones. smjcolors must precede smjtypo;
%         smjcore must precede smjtheorems, smjartwork, and
%         smjbib; hyperref must stay last.
%
%      4. Do NOT edit this file to change styling. Edit the
%         submodule that owns the styling concern instead.
%
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{smj}[2026/03/15 SMJ Journal Style v1.0]

\makeatletter
\def\input@path{{smj/}}
\makeatother

% ????????????????????????????????????????????????????????
%  SMJ master package ? loads submodules in dependency order
% ????????????????????????????????????????????????????????

% 1. Fonts (must be first)
\RequirePackage{smjfonts}

% 2. Colors
\RequirePackage{smjcolors}

% 3. Math, graphics, tables, algorithms ? infrastructure
\RequirePackage{amsmath, amssymb, amsthm}
\RequirePackage{physics}
\RequirePackage{cancel}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{calc, arrows.meta, decorations.markings, shadings, positioning, 3d}
\RequirePackage[most]{tcolorbox}
\RequirePackage{booktabs}
\RequirePackage{colortbl}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{multicol}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage{comment}
\RequirePackage{footnote}
\RequirePackage{enumitem}
\RequirePackage{abstract}
\RequirePackage{xparse}

% 4. Typography
\RequirePackage{smjtypo}

% 5. Layout
\RequirePackage{smjlayout}

% 6. Core metadata & counters
\RequirePackage{smjcore}

% 7. Headers
\RequirePackage{smjheaders}

% 8. Sections
\RequirePackage{smjsections}

% 9. Theorems
\RequirePackage{smjtheorems}

% 10. Article display & rendering
\RequirePackage{smjartwork}

% 11. Bibliography
\RequirePackage{smjbib}

% 12. Hyperlinks (last)
\RequirePackage{hyperref}
\RequirePackage{cleveref}

\hypersetup{
  colorlinks  = true,
  linkcolor   = smjcrimson,
  citecolor   = smjcrimson!70!black,
  urlcolor    = smjcrimson!80!black,
  pdftitle    = {The Student Mathematical Journal},
  pdfauthor   = {Constructor University Mathematics Society}
}

% Cover version line ? set from main.tex via \smjvolume{...}
\newcommand{\smjvolume}[1]{\renewcommand{\smjvolume}{#1}}

\endinput
